      "parameters": {
        "jsCode": "// 1. Extraemos el archivo binario\nconst binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\n\n// 2. Lo convertimos a texto plano\nconst rawText = binaryData.toString('utf8');\n\n// 3. Separamos el texto por saltos de línea\nconst lines = rawText.split('\\n');\nlet items = [];\n\n// 4. Recorremos cada línea y la transformamos en JSON\nfor (let line of lines) {\n  if (line.trim() !== \"\") {\n    try {\n      let parsedJson = JSON.parse(line);\n      items.push({ json: parsedJson });\n    } catch (e) {\n      // Ignoramos líneas rotas o vacías\n    }\n  }\n}\n\nreturn items;"
      },
