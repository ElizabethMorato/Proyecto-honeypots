      "parameters": {
        "jsCode": "const binaryData = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst rawText = binaryData.toString('utf8');\nconst lines = rawText.split('\\n');\n\nconst lastTimestamp = $getWorkflowStaticData('global').lastTimestamp || '1970-01-01T00:00:00.000Z';\n\nlet newItems = [];\nlet maxTimestamp = lastTimestamp;\n\nfor (let line of lines) {\n  if (line.trim() !== \"\") {\n    try {\n      let parsedJson = JSON.parse(line);\n      if (parsedJson.timestamp && parsedJson.timestamp > lastTimestamp) {\n        newItems.push({ json: parsedJson });\n        if (parsedJson.timestamp > maxTimestamp) {\n          maxTimestamp = parsedJson.timestamp;\n        }\n      }\n    } catch (e) {}\n  }\n}\n\n$getWorkflowStaticData('global').lastTimestamp = maxTimestamp;\n\nreturn newItems;"
      },
